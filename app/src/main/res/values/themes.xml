<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal de la app -->
    <style name="Theme.OverDriveXAndroid" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema de la Splash Screen (Splash Screen API de AndroidX) -->
    <style name="Theme.OverDriveXAndroid.SplashScreen" parent="Theme.SplashScreen">
        <!-- Icono / logo centrado (LogoAndroid.png) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <!-- Fondo completo (FondoAndroidFondo.png) -->
        <item name="windowSplashScreenBackground">@drawable/splash_screen</item>
        <!-- Duración (ms) antes de pasar al tema de la app -->
        <item name="postSplashScreenTheme">@style/Theme.OverDriveXAndroid</item>
    </style>

</resources>